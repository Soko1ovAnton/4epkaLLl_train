<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/weight_layout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Вес, кг"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/in_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <Space android:layout_width="12dp" android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/reps_layout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Повторы"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/in_reps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_last_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="10dp"
        android:gravity="center"
        android:text="⤓ Прошлый раз"
        android:textColor="@color/md_theme_primary"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chk_failure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отказ (до отказа)" />

    <LinearLayout
        android:id="@+id/dropset_toggle_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dropset"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Дропсет" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="сброс веса → ещё повторы"
            android:textSize="11sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dropset_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_add_drop_stage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center"
        android:text="＋ Ступень дропсета"
        android:textColor="@color/md_theme_dropset"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btn_delete_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:gravity="center"
        android:text="Удалить подход"
        android:textColor="@color/md_theme_error"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone" />
</LinearLayout>